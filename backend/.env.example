# Copia para .env e preenche. Nao commitar .env.

# Local: sqlite. Postgres so se voce subir o banco.
DATABASE_URL=sqlite+aiosqlite:///./data/leiloes.db

# GLiNER local via Cloudflare Tunnel (mesmo do venda-epis)
GLINER_URL=https://gliner.ia.ia.nom.br
GLINER_API_TOKEN=

# OpenRouter — extração de cidade/tipo/endereço quando o HTML não traz
OPENROUTER_API_KEY=
OPENROUTER_EXTRACT_MODEL=mistralai/ministral-8b-2512
OPENROUTER_SITE_URL=http://127.0.0.1:8050
OPENROUTER_APP_NAME=leiloes

# Alerta de oportunidade (Telegram) — sem os dois, o alerta so fica desligado
# Bot criado com @BotFather; chat_id via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_MIN_SCORE=70
